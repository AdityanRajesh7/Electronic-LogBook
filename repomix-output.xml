            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>

      {/* Mentee Detailed Logbook Inspector Dialog Modal */}
      <Dialog open={!!selectedMentee} onOpenChange={() => setSelectedMentee(null)}>
