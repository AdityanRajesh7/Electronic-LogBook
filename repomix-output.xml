  html {
    background: #dff8f6;
  }
  body {
    @apply font-sans antialiased bg-background text-foreground;
    min-width: 320px;
    background:
      radial-gradient(circle at 6% 0%, rgba(94, 234, 212, .28), transparent 30rem),
      radial-gradient(circle at 94% 4%, rgba(34, 211, 238, .22), transparent 32rem),
      linear-gradient(145deg, #e2faf7 0%, #f8ffff 48%, #e8f9fb 100%);
