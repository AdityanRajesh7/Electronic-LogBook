  header {
    display: none !important;
  }

  .print-only {
    display: block !important;
  }

  main {
    max-width: none !important;
    padding: 0 !important;
  }

  .glass-panel,
  [data-slot="card"] {
    break-inside: avoid;
    box-shadow: none !important;
