  date: text("date").notNull(),
  clockIn: text("clock_in"),
  clockOut: text("clock_out"),
  status: text("status", { enum: ["present", "absent", "half_day", "leave"] }).notNull().default("present"),
  verifiedBy: integer("verified_by").references(() => usersTable.id),
